
{
  "name": "bdmg-landing-page-generator",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "bdmg:agent": "pnpm --filter @bdmg/landing-page-agent start",
    "bdmg:generate": "pnpm --filter @bdmg/landing-page-agent generate",
    "bdmg:parse": "pnpm --filter @bdmg/landing-page-agent parse",
    "bdmg:qa": "pnpm --filter @bdmg/landing-page-agent qa",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "mammoth": "^1.13.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "turbo": "^2.5.0"
  }
}
