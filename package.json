
{
  "name": "bdmg-landing-page-generator",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "parse:docx": "tsx src/parsers/parse-docx.ts",
    "normalize:figma": "tsx src/normalizers/normalize-figma.ts",
    "build:blueprint": "tsx src/blueprint/build-blueprint.ts",
    "pipeline": "pnpm parse:docx && pnpm normalize:figma && pnpm build:blueprint",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "mammoth": "^1.13.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "turbo": "^2.5.0"
  }
}
